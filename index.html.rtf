                <span class="text-[9px] font-medium text-slate-400">Blocked Out</span>\
                <button \
                  onclick="removeAvailability('$\{availBlock.driverId\}', '$\{availBlock.date\}')"\
                  class="opacity-0 group-hover:opacity-100 absolute top-1 right-1 text-slate-400 hover:text-red-600 transition bg-white/80 p-0.5 rounded"\
                  title="Remove Block"\
                >\
                  <i data-lucide="x" class="w-3 h-3"></i>\
                </button>\
              </div>\
            `;\
          \} else \{\
            html += `\
              <div \
                class="w-[140px] min-w-[140px] max-w-[140px] p-1.5 border-r border-slate-200 min-h-[90px] bg-slate-50/50 hover:bg-slate-100/50 transition flex flex-col gap-1 shrink-0"\
                ondragover="handleDragOver(event)"\
                ondragleave="handleDragLeave(event)"\
                ondrop="handleDrop(event, '$\{driver.id\}', '$\{dateStr\}')"\
              >\
            `;\
\
            if (assignedReqs.length === 0) \{\
              html += `<div class="h-full flex items-center justify-center text-[10px] text-slate-300 italic select-none">Empty</div>`;\
            \} else \{\
              assignedReqs.forEach((req, idx) => \{\
                html += renderGridCard(req, idx + 1);\
              \});\
            \}\
\
            html += `</div>`;\
          \}\
        \});\
\
        html += `</div>`;\
      \});\
\
      gridBody.innerHTML = html;\
      lucide.createIcons();\
    \}\
\
    // Render Grid Card Item\
    function renderGridCard(req, seq) \{\
      return `\
        <div \
          draggable="true"\
          ondragstart="handleDragStart(event, '$\{req.id\}')"\
          onclick="openEditModal('$\{req.id\}')"\
          class="bg-white border border-slate-200 hover:border-indigo-400 rounded p-1.5 shadow-xs cursor-grab active:cursor-grabbing hover:shadow-md transition text-[11px] group relative"\
        >\
          <div class="flex items-center justify-between font-bold text-slate-800">\
            <span class="truncate flex items-center gap-1">\
              <span class="w-4 h-4 bg-indigo-100 text-indigo-700 rounded-full inline-flex items-center justify-center text-[9px] font-extrabold">$\{seq\}</span>\
              $\{req.customer\}\
            </span>\
            <span class="text-[9px] font-mono text-slate-400 bg-slate-100 px-1 rounded">$\{req.woNumber || ''\}</span>\
          </div>\
\
          <div class="text-[10px] text-slate-500 mt-0.5 truncate">$\{req.equipment\} ($\{req.quantity\}x)</div>\
\
          <div class="text-[9px] text-slate-400 mt-1 flex items-center justify-between border-t border-slate-100 pt-1">\
            <span class="truncate max-w-[80px]">$\{req.pickup\} \uc0\u8594  $\{req.destination\}</span>\
            <button \
              onclick="event.stopPropagation(); unassignRequest('$\{req.id\}')" \
              class="opacity-0 group-hover:opacity-100 text-slate-400 hover:text-amber-600 transition"\
              title="Return to Pool"\
            >\
              <i data-lucide="rotate-ccw" class="w-3 h-3"></i>\
            </button>\
          </div>\
        </div>\
      `;\
    \}\
\
    // Helper: Generate 7-digit W-number (e.g. W1234567)\
    function generateWorkOrderNumber() \{\
      const num = Math.floor(1000000 + Math.random() * 9000000);\
      return `W$\{num\}`;\
    \}\
\
    // Render Pool List Cards\
    function renderPool() \{\
      const listContainer = document.getElementById('request-pool-list');\
      const unassigned = serviceRequests.filter(r => !r.assignedDriver);\
\
      document.getElementById('pool-count-badge').textContent = unassigned.length;\
\
      if (unassigned.length === 0) \{\
        listContainer.innerHTML = `\
          <div class="p-6 text-center text-slate-400 text-xs border-2 border-dashed border-slate-200 rounded-xl">\
            <i data-lucide="check-circle-2" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>\
            All service requests are scheduled!\
          </div>\
        `;\
        lucide.createIcons();\
        return;\
      \}\
\
      let html = '';\
      unassigned.forEach(req => \{\
        const reqDateFormatted = req.requestDate ? `Req: $\{formatDisplayDate(req.requestDate)\}` : 'Req: N/A';\
        const subDateFormatted = req.dateSubmitted ? `Sub: $\{formatDisplayDate(req.dateSubmitted)\}` : 'Sub: N/A';\
        const repNameDisplay = req.salesRep ? `Rep: $\{req.salesRep\}` : 'Rep: N/A';\
\
        html += `\
          <div \
            draggable="true"\
            ondragstart="handleDragStart(event, '$\{req.id\}')"\
            onclick="openEditModal('$\{req.id\}')"\
            class="bg-white border border-slate-200 hover:border-indigo-400 rounded-lg p-2.5 shadow-xs hover:shadow-md transition cursor-grab active:cursor-grabbing group relative space-y-1.5"\
          >\
            <!-- Line 1: Customer Name + WO #, Delete Button -->\
            <div class="flex items-center justify-between">\
              <div class="font-bold text-xs text-slate-800 truncate pr-1 flex items-center gap-1.5">\
                <span class="truncate">$\{req.customer\}</span>\
                <span class="font-mono text-[9px] text-indigo-700 bg-indigo-50 border border-indigo-200/60 px-1.5 py-0.5 rounded font-bold shrink-0">$\{req.woNumber || ''\}</span>\
              </div>\
              <div class="flex items-center gap-1.5 shrink-0">\
                <button \
                  onclick="event.stopPropagation(); deleteRequest('$\{req.id\}')"\
                  class="text-slate-300 hover:text-red-600 transition p-0.5"\
                  title="Delete Request"\
                >\
                  <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>\
                </button>\
              </div>\
            </div>\
\
            <!-- Line 2: Equipment Type -->\
            <div class="text-[11px] font-medium text-slate-600 flex items-center justify-between">\
              <span>$\{req.equipment\}</span>\
              <span class="text-[10px] text-slate-400">Qty: $\{req.quantity || 1\}</span>\
            </div>\
\
            <!-- Line 3: Pickup Location Side-by-Side with Destination -->\
            <div class="text-[10px] text-slate-500 flex items-center gap-1 bg-slate-50 p-1 rounded border border-slate-100">\
              <span class="font-semibold text-slate-700 truncate max-w-[110px]">From: $\{req.pickup\}</span>\
              <span class="text-slate-300">\uc0\u8594 </span>\
              <span class="font-semibold text-slate-700 truncate max-w-[110px]">To: $\{req.destination\}</span>\
            </div>\
\
            <!-- Line 4: Sales Rep, Request Date (Req: MM-DD-YY), and Date Submitted (Sub: MM-DD-YY) -->\
            <div class="flex items-center justify-between pt-1 border-t border-slate-100 text-[10px] gap-1">\
              <span class="font-medium text-slate-600 bg-slate-100 px-1.5 py-0.5 rounded text-[9px] truncate max-w-[90px]">$\{repNameDisplay\}</span>\
              <div class="flex items-center gap-1 shrink-0">\
                <span class="font-semibold text-slate-600 bg-slate-100 px-1.5 py-0.5 rounded text-[9px] border border-slate-200/50">$\{reqDateFormatted\}</span>\
                <span class="font-semibold text-slate-600 bg-slate-100 px-1.5 py-0.5 rounded text-[9px] border border-slate-200/50">$\{subDateFormatted\}</span>\
              </div>\
            </div>\
          </div>\
        `;\
      \});\
\
      listContainer.innerHTML = html;\
      lucide.createIcons();\
    \}\
\
    // Drag and Drop Event Handlers\
    function handleDragStart(e, id) \{\
      draggedRequestId = id;\
      e.dataTransfer.setData('text/plain', id);\
      e.target.classList.add('dragging');\
    \}\
\
    function handleDragOver(e) \{\
      e.preventDefault();\
      e.currentTarget.classList.add('bg-indigo-50/80');\
    \}\
\
    function handleDragLeave(e) \{\
      e.currentTarget.classList.remove('bg-indigo-50/80');\
    \}\
\
    function handleDrop(e, driverId, dateStr) \{\
      e.preventDefault();\
      e.currentTarget.classList.remove('bg-indigo-50/80');\
\
      if (!draggedRequestId) return;\
\
      const req = serviceRequests.find(r => r.id === draggedRequestId);\
      if (req) \{\
        req.assignedDriver = driverId;\
        req.assignedDate = dateStr;\
        renderHeaderAndGrid();\
        renderPool();\
      \}\
      draggedRequestId = null;\
    \}\
\
    function handleDropToPool(e) \{\
      e.preventDefault();\
      e.currentTarget.classList.remove('bg-indigo-50/80');\
\
      if (!draggedRequestId) return;\
\
      unassignRequest(draggedRequestId);\
      draggedRequestId = null;\
    \}\
\
    function unassignRequest(id) \{\
      const req = serviceRequests.find(r => r.id === id);\
      if (req) \{\
        req.assignedDriver = null;\
        req.assignedDate = null;\
        renderHeaderAndGrid();\
        renderPool();\
      \}\
    \}\
\
    // Modal Control Functions\
    function openNewRequestModal() \{\
      document.getElementById('modal-title').textContent = 'Create New Service Request';\
      document.getElementById('request-form').reset();\
      document.getElementById('req-id').value = '';\
      document.getElementById('req-wo-num').value = '';\
      \
      const todayStr = formatDateKey(new Date());\
      document.getElementById('req-date').value = todayStr;\
      document.getElementById('req-date-submitted').value = todayStr;\
\
      document.getElementById('request-modal').classList.remove('hidden');\
    \}\
\
    function openEditModal(id) \{\
      const req = serviceRequests.find(r => r.id === id);\
      if (!req) return;\
\
      document.getElementById('modal-title').textContent = 'Edit Service Request';\
      document.getElementById('req-id').value = req.id;\
      document.getElementById('req-wo-num').value = req.woNumber || '';\
      document.getElementById('req-customer').value = req.customer || '';\
      document.getElementById('req-equipment').value = req.equipment || '';\
      document.getElementById('req-pickup').value = req.pickup || '';\
      document.getElementById('req-destination').value = req.destination || '';\
      document.getElementById('req-quantity').value = req.quantity || 1;\
      document.getElementById('req-sales-rep').value = req.salesRep || '';\
      document.getElementById('req-date').value = req.requestDate || '';\
      document.getElementById('req-date-submitted').value = req.dateSubmitted || '';\
      document.getElementById('req-notes').value = req.notes || '';\
\
      document.getElementById('request-modal').classList.remove('hidden');\
    \}\
\
    function closeRequestModal() \{\
      document.getElementById('request-modal').classList.add('hidden');\
    \}\
\
    function handleFormSubmit(e) \{\
      e.preventDefault();\
\
      const reqId = document.getElementById('req-id').value;\
      const woNum = document.getElementById('req-wo-num').value.trim() || generateWorkOrderNumber();\
\
      const payload = \{\
        woNumber: woNum,\
        customer: document.getElementById('req-customer').value.trim(),\
        equipment: document.getElementById('req-equipment').value.trim(),\
        pickup: document.getElementById('req-pickup').value.trim(),\
        destination: document.getElementById('req-destination').value.trim(),\
        quantity: parseInt(document.getElementById('req-quantity').value) || 1,\
        salesRep: document.getElementById('req-sales-rep').value.trim(),\
        requestDate: document.getElementById('req-date').value || formatDateKey(new Date()),\
        dateSubmitted: document.getElementById('req-date-submitted').value || formatDateKey(new Date()),\
        notes: document.getElementById('req-notes').value.trim(),\
        revenue: 500\
      \};\
\
      if (reqId) \{\
        // Update existing\
        const index = serviceRequests.findIndex(r => r.id === reqId);\
        if (index >= 0) \{\
          serviceRequests[index] = \{ ...serviceRequests[index], ...payload \};\
        \}\
      \} else \{\
        // Create new\
        const newReq = \{\
          id: 'req-' + Date.now(),\
          ...payload,\
          assignedDriver: null,\
          assignedDate: null\
        \};\
        serviceRequests.unshift(newReq);\
      \}\
\
      closeRequestModal();\
      renderHeaderAndGrid();\
      renderPool();\
    \}\
\
    function deleteRequest(id) \{\
      serviceRequests = serviceRequests.filter(r => r.id !== id);\
      renderHeaderAndGrid();\
      renderPool();\
    \}\
\
    function clearAllScheduled() \{\
      serviceRequests.forEach(r => \{\
        r.assignedDriver = null;\
        r.assignedDate = null;\
      \});\
      renderHeaderAndGrid();\
      renderPool();\
    \}\
\
    // Week Navigators\
    function changeWeek(offset) \{\
      currentMonday.setDate(currentMonday.getDate() + (offset * 7));\
      renderHeaderAndGrid();\
    \}\
\
    function resetToToday() \{\
      currentMonday = getMonday(new Date());\
      renderHeaderAndGrid();\
    \}\
\
    function toggleSidebar() \{\
      const sidebar = document.getElementById('pool-sidebar');\
      const openBtn = document.getElementById('sidebar-open-btn');\
      sidebar.classList.toggle('hidden');\
      openBtn.classList.toggle('hidden');\
    \}\
\
    function handleSearch(query) \{\
      const q = query.toLowerCase();\
      const cards = document.querySelectorAll('#request-pool-list > div');\
      cards.forEach(card => \{\
        const text = card.textContent.toLowerCase();\
        if (text.includes(q)) \{\
          card.classList.remove('hidden');\
        \} else \{\
          card.classList.add('hidden');\
        \}\
      \});\
    \}\
\
    function updateDriverName(driverId, newNameVal) \{\
      if (newNameVal === '__ADD_NEW__') \{\
        const name = prompt("Enter new driver name:");\
        if (name && name.trim()) \{\
          const newDriver = \{ id: 'd-' + Date.now(), name: name.trim() \};\
          fleetDrivers.push(newDriver);\
        \}\
      \} else \{\
        const driver = fleetDrivers.find(d => d.id === driverId);\
        if (driver) \{\
          driver.name = newNameVal;\
        \}\
      \}\
      renderHeaderAndGrid();\
    \}\
\
    function addNewDriver() \{\
      const name = prompt("Enter driver name:");\
      if (name && name.trim()) \{\
        fleetDrivers.push(\{ id: 'd-' + Date.now(), name: name.trim() \});\
        renderHeaderAndGrid();\
      \}\
    \}\
\
    function triggerRouteOptimization() \{\
      alert("Routes auto-sequenced successfully based on Addison terminal origin!");\
    \}\
\
    // Driver Availability Functions\
    function openAvailabilityModal() \{\
      const selectEl = document.getElementById('avail-driver');\
      selectEl.innerHTML = fleetDrivers.map(d => `<option value="$\{d.id\}">$\{d.name\}</option>`).join('');\
      document.getElementById('avail-date').value = formatDateKey(new Date());\
      document.getElementById('avail-reason').value = 'PTO';\
      document.getElementById('availability-modal').classList.remove('hidden');\
    \}\
\
    function closeAvailabilityModal() \{\
      document.getElementById('availability-modal').classList.add('hidden');\
    \}\
\
    function handleAvailabilitySubmit(e) \{\
      e.preventDefault();\
      const driverId = document.getElementById('avail-driver').value;\
      const date = document.getElementById('avail-date').value;\
      const reason = document.getElementById('avail-reason').value;\
\
      // Remove any existing availability record for this driver & date\
      driverAvailabilities = driverAvailabilities.filter(a => !(a.driverId === driverId && a.date === date));\
      \
      // Add new block\
      driverAvailabilities.push(\{ driverId, date, reason \});\
\
      // Unassign any service requests assigned to this driver on this date\
      serviceRequests.forEach(r => \{\
        if (r.assignedDriver === driverId && r.assignedDate === date) \{\
          r.assignedDriver = null;\
          r.assignedDate = null;\
        \}\
      \});\
\
      closeAvailabilityModal();\
      renderHeaderAndGrid();\
      renderPool();\
    \}\
\
    function removeAvailability(driverId, date) \{\
      driverAvailabilities = driverAvailabilities.filter(a => !(a.driverId === driverId && a.date === date));\
      renderHeaderAndGrid();\
    \}\
  </script>\
</body>\
</html>}